#!/bin/sh
# PolyQuery launcher: runs the executable produced by `make build`.
# Works from any current directory (resolves its own location, following symlinks).
self="$0"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
root="$(cd "$(dirname "$self")/.." && pwd)"
exe="$root/build/polyquery"
if [ ! -x "$exe" ]; then
  echo "polyquery: engine not built; run 'make -C $root build'" >&2
  exit 1
fi
exec "$exe" "$@"
