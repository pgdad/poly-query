#!/bin/sh
# PolyQuery launcher: runs the AOT-compiled engine (build with `make build`).
# Extra JVM options can be passed via POLYQUERY_JAVA_OPTS (e.g. -Xmx8g).
set -e
HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(dirname -- "$HERE")"
CP_FILE="$ROOT/target/classpath"
if [ ! -f "$CP_FILE" ] || [ ! -f "$ROOT/target/polyquery.jar" ]; then
  echo "polyquery: engine is not built; run 'make -C $ROOT build'" >&2
  exit 1
fi
JAVA="${JAVA_HOME:+$JAVA_HOME/bin/}java"
# The JVM's ahead-of-time cache (classes loaded and linked, JIT profiles),
# recorded by a training run during `make build`; the JVM ignores it (with a
# warning on stderr) if it does not match this JVM or classpath.
AOT=""
if [ -f "$ROOT/target/polyquery.aot" ]; then
  AOT="-XX:AOTCache=$ROOT/target/polyquery.aot"
fi
# -Xlog settings keep JVM warnings off stdout, which carries the protocol;
# native access is enabled for the optional kernel library (--native-kernels).
exec "$JAVA" --enable-native-access=ALL-UNNAMED -Xss16m -XX:+UseParallelGC -XX:+DisplayVMOutputToStderr -Xlog:disable -Xlog:all=warning:stderr \
  $AOT ${POLYQUERY_JAVA_OPTS:-} -cp "$ROOT/target/polyquery.jar:$(cat "$CP_FILE")" polyquery.main "$@"
