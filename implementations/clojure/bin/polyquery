#!/bin/sh
# PolyQuery launcher: runs the AOT-compiled engine (build with `make build`).
# Extra JVM options can be passed via POLYQUERY_JAVA_OPTS (e.g. -Xmx8g).
set -e
HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(dirname -- "$HERE")"
CP_FILE="$ROOT/target/classpath"
if [ ! -f "$CP_FILE" ] || [ ! -d "$ROOT/target/classes" ]; then
  echo "polyquery: engine is not built; run 'make -C $ROOT build'" >&2
  exit 1
fi
JAVA="${JAVA_HOME:+$JAVA_HOME/bin/}java"
# -Xlog settings keep JVM warnings off stdout, which carries the protocol.
exec "$JAVA" -Xss16m -XX:+UseParallelGC -Xlog:disable -Xlog:all=warning:stderr \
  ${POLYQUERY_JAVA_OPTS:-} -cp "$ROOT/target/classes:$(cat "$CP_FILE")" polyquery.main "$@"
