[30, true, 0, "-2.10", 3.75, "red", "2020-01-31", "2024-01-02 06:00:30.000030"]
[299, false, null, "20.93", 1.0, "", null, "2024-01-13 11:04:59.000299"]
[300, true, 3, "-21.00", 1.125, "red", "2020-10-27", "2024-01-13 12:05:00.000300"]
[301, false, 3, "21.07", 1.25, "green", "2020-10-28", "2024-01-13 13:05:01.000301"]
[1999, false, 19, "139.93", 7.375, "green", "2020-07-18", "2024-03-24 07:33:19.000999"]
[2000, false, 20, "-140.00", 7.5, "blue", "2020-07-19", "2024-03-24 08:33:20"]

# index metadata in the file is honored: the index can be dropped
statement ok
DROP INDEX types_id_idx

open people fixtures/pqcf/people.pqcf

query ordered oracle
SELECT * FROM people ORDER BY id
----
id INT64 | name STRING | age INT64 | city STRING | score FLOAT64 | active BOOLEAN | joined DATE
[1, "Alice", 34, "Helsinki", 88.5, true, "2020-01-15"]
[2, "Bob", 28, "Tampere", 72.25, false, "2021-03-01"]
[3, "Carol", 45, "Helsinki", 91.0, true, "2019-07-30"]
[4, "Dave", null, "Oulu", 65.5, true, "2022-11-11"]
[5, "Eve", 28, null, 79.75, false, null]
[6, "Frank", 52, "Tampere", null, true, "2018-02-28"]
[7, "Grace", 34, "Helsinki", 95.5, null, "2020-01-15"]
[8, "heidi", 41, "Espoo", 58.0, false, "2023-05-05"]

open empty fixtures/pqcf/empty.pqcf

query
SELECT COUNT(*) AS n, MAX(a) AS m FROM empty
----
n INT64 | m INT64
[0, null]

# unknown metadata keys are ignored
open fc fixtures/pqcf/forward_compat.pqcf

query ordered
SELECT a FROM fc ORDER BY a
----
a INT64
[1]
[2]

# corrupted and unsupported files
corrupt c1 fixtures/pqcf/corrupt/bad_header_magic.pqcf STORAGE_CORRUPT
corrupt c2 fixtures/pqcf/corrupt/bad_trailer_magic.pqcf STORAGE_CORRUPT
corrupt c3 fixtures/pqcf/corrupt/bad_type.pqcf STORAGE_CORRUPT
corrupt c4 fixtures/pqcf/corrupt/chunk_bitflip.pqcf STORAGE_CORRUPT
corrupt c5 fixtures/pqcf/corrupt/chunk_out_of_bounds.pqcf STORAGE_CORRUPT
corrupt c6 fixtures/pqcf/corrupt/empty_file.pqcf STORAGE_CORRUPT
corrupt c7 fixtures/pqcf/corrupt/flags.pqcf STORAGE_VERSION_UNSUPPORTED
corrupt c8 fixtures/pqcf/corrupt/invalid_utf8.pqcf STORAGE_CORRUPT
corrupt c9 fixtures/pqcf/corrupt/meta_bitflip.pqcf STORAGE_CORRUPT
corrupt c10 fixtures/pqcf/corrupt/missing_chunk.pqcf STORAGE_CORRUPT
corrupt c11 fixtures/pqcf/corrupt/not_json_meta.pqcf STORAGE_CORRUPT
corrupt c12 fixtures/pqcf/corrupt/row_count_mismatch.pqcf STORAGE_CORRUPT
corrupt c13 fixtures/pqcf/corrupt/truncated_half.pqcf STORAGE_CORRUPT
corrupt c14 fixtures/pqcf/corrupt/truncated_tail.pqcf STORAGE_CORRUPT
corrupt c15 fixtures/pqcf/corrupt/unknown_encoding.pqcf STORAGE_VERSION_UNSUPPORTED
corrupt c16 fixtures/pqcf/corrupt/version3.pqcf STORAGE_VERSION_UNSUPPORTED

# failed opens leave no table behind
request
{"op":"schema","table":"c1"}
----
error NOT_FOUND
