query ordered oracle
SELECT * FROM ta WHERE id IN (1, 2, 3, 11, 13, 17, 19, 23, 29, 30, 299, 300, 301, 1999, 2000) ORDER BY id
----
id INT64 | flag BOOLEAN | qty INT64 | price DECIMAL(10,2) | ratio FLOAT64 | label STRING | day DATE | at TIMESTAMP
[1, false, 0, "0.07", 0.125, "green", "2020-01-02", "2024-01-01 01:00:01.000001"]
[2, false, 0, "0.14", 0.25, "blue", "2020-01-03", "2024-01-01 02:00:02.000002"]
[3, true, 0, "0.21", 0.375, null, "2020-01-04", "2024-01-01 03:00:03.000003"]
[11, null, 0, "0.77", 1.375, "", "2020-01-12", "2024-01-01 11:00:11.000011"]
[13, false, null, "0.91", 1.625, "green", "2020-01-14", "2024-01-01 13:00:13.000013"]
[17, false, 0, null, 2.125, "", "2020-01-18", "2024-01-01 17:00:17.000017"]
[19, false, 0, "1.33", null, "green", "2020-01-20", "2024-01-01 19:00:19.000019"]
[23, false, 0, "1.61", 2.875, "", null, "2024-01-01 23:00:23.000023"]
