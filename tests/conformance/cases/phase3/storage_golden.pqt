# Reading PQCF files written by the independent reference writer — interoperability
@phase 3
@requires phase3 storage.pqcf sql.groupby

open tp fixtures/pqcf/types_plain.pqcf
open ta fixtures/pqcf/types_auto.pqcf
open td fixtures/pqcf/types_dict.pqcf
open tr fixtures/pqcf/types_rle.pqcf mmap=true

request
{"op":"schema","table":"ta"}
----
match {"ok":true,"row_count":2000,"columns":[{"name":"id","type":"INT64"},{"name":"flag","type":"BOOLEAN"},{"name":"qty","type":"INT64"},{"name":"price","type":"DECIMAL(10,2)"},{"name":"ratio","type":"FLOAT64"},{"name":"label","type":"STRING"},{"name":"day","type":"DATE"},{"name":"at","type":"TIMESTAMP"}],"indexes":[{"name":"types_id_idx","column":"id","kind":"BTREE"},{"name":"types_label_idx","column":"label","kind":"HASH"}]}

query ordered oracle
SELECT label, COUNT(*) AS n, COUNT(flag) AS flags, SUM(qty) AS q, SUM(price) AS p, MIN(day) AS d0, MAX(at) AS t1, SUM(ratio) AS r FROM tp GROUP BY label ORDER BY label
----
label STRING | n INT64 | flags INT64 | q INT64 | p DECIMAL(18,2) | d0 DATE | t1 TIMESTAMP | r FLOAT64
[null, 333, 303, 2910, "13002.99", "2020-01-04", "2024-03-24 03:33:15.000995", 1857.125]
["", 333, 302, 2929, "13286.21", "2020-01-06", "2024-03-24 05:33:17.000997", 1878.625]
["blue", 334, 304, 2933, "13141.80", "2020-01-03", "2024-03-24 08:33:20", 1865.75]
["green", 334, 304, 2929, "13282.01", "2020-01-02", "2024-03-24 07:33:19.000999", 1878.875]
["red", 333, 303, 2932, "13142.22", "2020-01-01", "2024-03-24 06:33:18.000998", 1879.875]
["ünïcödé", 333, 303, 2932, "13144.60", "2020-01-05", "2024-03-24 04:33:16.000996", 1877.375]

