# Hash and ordered indexes — storage/indexes-and-planning.md §2-§4
@phase 3
@requires phase3 index.hash index.btree ingest.csv sql.groupby sql.join

load tx fixtures/gen/transactions.csv schemafile=fixtures/gen/transactions.schema.json
load cust fixtures/gen/customers.csv schemafile=fixtures/gen/customers.schema.json
load people fixtures/people.csv

statement ok
CREATE INDEX tx_id_h ON tx (tx_id) USING HASH

statement ok
CREATE INDEX tx_ts_b ON tx (ts) USING BTREE

statement ok
CREATE INDEX tx_cust ON tx (customer_id)

statement ok
CREATE INDEX people_age ON people (age) USING BTREE

statement ok
CREATE INDEX people_city ON people (city) USING HASH

statement error ALREADY_EXISTS
CREATE INDEX tx_id_h ON tx (merchant_id)

statement ok
CREATE INDEX IF NOT EXISTS tx_id_h ON tx (merchant_id)

statement error SEMANTIC_ERROR
CREATE INDEX bad ON tx (no_such_column)

statement error SEMANTIC_ERROR
CREATE INDEX bad ON no_such_table (x)

statement error PARSE_ERROR
CREATE INDEX bad ON tx (tx_id) USING BITMAP

request
{"op":"schema","table":"people"}
----
match {"ok":true,"indexes":[{"name":"people_age","column":"age","kind":"BTREE"},{"name":"people_city","column":"city","kind":"HASH"}]}

# --- equality and IN lookups (hash and btree)
query ordered oracle
SELECT tx_id, customer_id, amount FROM tx WHERE tx_id = 1234
----
tx_id INT64 | customer_id INT64 | amount DECIMAL(12,2)
[1234, 12, "671.44"]

query ordered oracle
SELECT tx_id FROM tx WHERE tx_id IN (5, 77, 1999, 4000) ORDER BY tx_id
----
tx_id INT64
[5]
[77]
[1999]

query ordered oracle
SELECT tx_id FROM tx WHERE tx_id = 99999
----
tx_id INT64

query ordered oracle
SELECT id FROM people WHERE city = 'Helsinki' ORDER BY id
----
id INT64
[1]
[3]
[7]

# NULLs are never returned by index lookups
query ordered oracle
SELECT id FROM people WHERE age >= 0 ORDER BY id
----
id INT64
[1]
[2]
[3]
[5]
[6]
[7]
[8]

# --- ranges on btree indexes
query ordered oracle
SELECT id, age FROM people WHERE age > 34 ORDER BY id
----
id INT64 | age INT64
[3, 45]
[6, 52]
[8, 41]

query ordered oracle
SELECT id FROM people WHERE age BETWEEN 28 AND 34 ORDER BY id
----
id INT64
[1]
[2]
[5]
[7]

query ordered oracle
SELECT id FROM people WHERE age < 28 OR age >= 52 ORDER BY id
----
id INT64
[6]

query oracle
SELECT COUNT(*) AS n, SUM(amount) AS s FROM tx WHERE ts >= TIMESTAMP '2024-03-01 00:00:00' AND ts < TIMESTAMP '2024-03-08 00:00:00'
----
n INT64 | s DECIMAL(18,2)
[18, "605837.57"]

query ordered oracle
SELECT tx_id, ts FROM tx WHERE ts BETWEEN TIMESTAMP '2023-06-01 00:00:00' AND TIMESTAMP '2023-06-01 23:59:59.999999' ORDER BY ts, tx_id
----
tx_id INT64 | ts TIMESTAMP
[331, "2023-06-01 08:24:13.217000"]
[891, "2023-06-01 22:41:45.611000"]

# index + residual predicates
query ordered oracle
SELECT tx_id FROM tx WHERE customer_id = 3 AND currency = 'EUR' AND amount > 50 ORDER BY tx_id
----
tx_id INT64
[4]
[20]
[198]
[249]
[262]
[281]
[324]
[387]
[480]
[481]
[545]
[581]
[586]
[601]
[650]
[737]
[814]
[830]
[835]
[840]
[978]
[979]
[1005]
[1039]
[1080]
[1105]
[1117]
[1188]
[1214]
[1293]
[1569]
[1593]
[1622]
[1647]
[1794]
[1916]
[1919]
[1938]
[1941]

# index usage in joins must not change results
query ordered oracle
SELECT c.customer_id, COUNT(*) AS n FROM cust c JOIN tx t ON t.customer_id = c.customer_id WHERE c.customer_id <= 5 GROUP BY c.customer_id ORDER BY c.customer_id
----
customer_id INT64 | n INT64
[1, 324]
[2, 166]
[3, 124]
[4, 91]
[5, 75]

# results are identical with indexes disabled
query ordered oracle options={"use_indexes": false}
SELECT id, age FROM people WHERE age > 34 ORDER BY id
----
id INT64 | age INT64
[3, 45]
[6, 52]
[8, 41]

query ordered oracle options={"use_indexes": false}
SELECT tx_id FROM tx WHERE tx_id IN (5, 77, 1999, 4000) ORDER BY tx_id
----
tx_id INT64
[5]
[77]
[1999]

# --- index selection is visible in EXPLAIN
explain
SELECT tx_id, amount FROM tx WHERE tx_id = 1234
----
index-scan tx_id_h

explain
SELECT tx_id FROM tx WHERE ts >= TIMESTAMP '2024-03-01 00:00:00' AND ts < TIMESTAMP '2024-03-02 00:00:00'
----
index-scan tx_ts_b

explain options={"use_indexes": false}
SELECT tx_id, amount FROM tx WHERE tx_id = 1234
----
no-index-scan

# non-selective predicate: a full scan is chosen
explain
SELECT COUNT(*) FROM tx WHERE ts >= TIMESTAMP '2000-01-01 00:00:00'
----
no-index-scan

# --- index lifecycle
statement ok
DROP INDEX tx_id_h

statement error NOT_FOUND
DROP INDEX tx_id_h

statement ok
DROP INDEX IF EXISTS tx_id_h

explain
SELECT tx_id, amount FROM tx WHERE tx_id = 1234
----
no-index-scan

query ordered oracle
SELECT tx_id, customer_id, amount FROM tx WHERE tx_id = 1234
----
tx_id INT64 | customer_id INT64 | amount DECIMAL(12,2)
[1234, 12, "671.44"]

# indexes are persisted in PQCF metadata and recreated on open
save people out/people_idx.pqcf
open people_r out/people_idx.pqcf expect=ALREADY_EXISTS

request
{"op":"schema","table":"people_r"}
----
error NOT_FOUND

# replacing the original table drops its indexes first, so the names are free again
open people out/people_idx.pqcf replace=true

request
{"op":"schema","table":"people"}
----
match {"ok":true,"row_count":8,"indexes":[{"name":"people_age","column":"age","kind":"BTREE"},{"name":"people_city","column":"city","kind":"HASH"}]}

statement ok
DROP INDEX people_age

statement ok
DROP INDEX people_city

open people_r out/people_idx.pqcf

request
{"op":"schema","table":"people_r"}
----
match {"ok":true,"indexes":[{"name":"people_age","column":"age","kind":"BTREE"},{"name":"people_city","column":"city","kind":"HASH"}]}

query ordered oracle
SELECT id FROM people_r WHERE age > 40 ORDER BY id
----
id INT64
[3]
[6]
[8]

explain
SELECT id FROM people_r WHERE city = 'Espoo'
----
index-scan people_city

# dropping a table drops its indexes
request
{"op":"drop","table":"people_r"}
----
ok

statement error NOT_FOUND
DROP INDEX people_city
