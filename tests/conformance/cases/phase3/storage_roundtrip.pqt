query ordered oracle
SELECT tx_id, amount, ts, is_fraud, fee FROM tx_rle WHERE tx_id % 397 = 0 ORDER BY tx_id
----
tx_id INT64 | amount DECIMAL(12,2) | ts TIMESTAMP | is_fraud BOOLEAN | fee DECIMAL(10,2)
[397, "50.80", "2024-04-04 12:38:04.324000", false, "0.57"]
[794, "986.28", "2024-12-21 01:49:44.211000", false, "10.13"]
[1191, "732.26", "2023-08-04 02:21:17.604000", false, null]
[1588, "81.84", "2023-11-01 07:48:32.924000", false, "1.25"]
[1985, "85.54", "2023-10-31 10:15:03.979000", false, null]

# null-heavy columns round trip exactly
save nulls out/nulls.pqcf row_group_size=128
open nulls2 out/nulls.pqcf

query ordered oracle
SELECT COUNT(n50) AS a, COUNT(n90) AS b, COUNT(s70) AS c, COUNT(f95) AS d, COUNT(b60) AS e, COUNT(d99) AS f, SUM(n50) AS g, MIN(d99) AS h, MAX(s70) AS i FROM nulls2
----
a INT64 | b INT64 | c INT64 | d INT64 | e INT64 | f INT64 | g INT64 | h DATE | i STRING
[1012, 205, 598, 88, 816, 20, 503440, "2022-01-21", "tango"]

query ordered oracle
SELECT * FROM nulls2 WHERE id <= 12 ORDER BY id
----
id INT64 | n50 INT64 | n90 INT64 | s70 STRING | f95 FLOAT64 | b60 BOOLEAN | d99 DATE
[1, null, null, "india", null, null, null]
[2, null, null, null, null, true, null]
[3, null, null, null, null, true, null]
[4, 17, null, null, null, true, null]
[5, null, null, "lima", null, null, null]
[6, 179, null, null, null, false, null]
[7, 4, null, null, null, true, null]
[8, null, null, null, 119.06, null, null]
[9, 901, null, null, null, null, null]
[10, 393, null, null, null, false, null]
[11, 404, null, null, null, null, null]
[12, 531, null, null, null, true, null]

# decimals, extreme dates/timestamps and awkward strings
save ledger out/ledger.pqcf
open ledger2 out/ledger.pqcf

query ordered
SELECT id, amount, fee FROM ledger2 ORDER BY id
----
id INT64 | amount DECIMAL(10,2) | fee DECIMAL(4,2)
[1, "100.25", "0.50"]
[2, "-40.10", "0.25"]
[3, "0.05", "0.00"]
[4, "999999.99", "1.75"]
[5, null, "0.10"]
[6, "12.00", null]

save dates out/dates.pqcf encoding=rle
open dates2 out/dates.pqcf

query ordered
SELECT d, t FROM dates2 ORDER BY d
----
d DATE | t TIMESTAMP
["0001-01-01", "9999-12-31 23:59:59"]
["2023-12-31", "2023-12-31 23:59:59.999999"]
["2024-02-29", "2024-02-29 00:00:00"]

save strings out/strings.pqcf encoding=dict
open strings2 out/strings.pqcf

query ordered oracle
SELECT id, s FROM strings2 ORDER BY id
----
id INT64 | s STRING
[1, "plain"]
[2, "with, comma"]
[3, "with \"quote\""]
[4, ""]
[5, null]
[6, "multi\nline"]
[7, "  spaced  "]
[8, "Ünïcödé"]

# empty table round trip
data empty csv schema=a:INT64;b:STRING
a,b
.
save empty out/empty.pqcf
open empty2 out/empty.pqcf

request
{"op":"schema","table":"empty2"}
----
match {"ok":true,"row_count":0,"columns":[{"name":"a","type":"INT64"},{"name":"b","type":"STRING"}]}

# overwrite an existing file atomically; reopen with replace
save ledger out/people.pqcf
open people2 out/people.pqcf replace=true

query
SELECT COUNT(*) AS n FROM people2
----
n INT64
[6]

# errors
open dup out/people.pqcf
open dup out/people.pqcf expect=ALREADY_EXISTS
save nope out/nope.pqcf expect=NOT_FOUND
open x out/does_not_exist.pqcf expect=NOT_FOUND
save people /tmp/escape.pqcf expect=ACCESS_DENIED
save people ../escape.pqcf expect=ACCESS_DENIED
open x ../../etc/passwd expect=ACCESS_DENIED
save people missing_dir/x.pqcf expect=IO_ERROR

# a CSV is not a PQCF file
corrupt notpq fixtures/people.csv STORAGE_CORRUPT

# temporary files are not left behind after successful saves (checked via reopen of the target only)
request
{"op":"tables"}
----
ok
