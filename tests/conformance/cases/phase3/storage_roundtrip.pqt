# PQCF save/open round trips — storage/pqcf-v1.md
@phase 3
@requires phase3 storage.pqcf ingest.csv sql.groupby

load people fixtures/people.csv
load tx fixtures/gen/transactions.csv schemafile=fixtures/gen/transactions.schema.json
load nulls fixtures/gen/nulls_heavy.csv schemafile=fixtures/gen/nulls_heavy.schema.json
load ledger fixtures/ledger.csv schema=id:INT64;account:STRING;amount:DECIMAL(10,2);fee:DECIMAL(4,2)
load dates fixtures/dates.csv
load strings fixtures/strings.csv

save people out/people.pqcf
open people2 out/people.pqcf

query ordered oracle
SELECT * FROM people2 ORDER BY id
----
id INT64 | name STRING | age INT64 | city STRING | score FLOAT64 | active BOOLEAN | joined DATE
[1, "Alice", 34, "Helsinki", 88.5, true, "2020-01-15"]
[2, "Bob", 28, "Tampere", 72.25, false, "2021-03-01"]
[3, "Carol", 45, "Helsinki", 91.0, true, "2019-07-30"]
[4, "Dave", null, "Oulu", 65.5, true, "2022-11-11"]
[5, "Eve", 28, null, 79.75, false, null]
[6, "Frank", 52, "Tampere", null, true, "2018-02-28"]
[7, "Grace", 34, "Helsinki", 95.5, null, "2020-01-15"]
[8, "heidi", 41, "Espoo", 58.0, false, "2023-05-05"]

request
{"op":"schema","table":"people2"}
----
match {"ok":true,"table":"people2","row_count":8,"columns":[{"name":"id","type":"INT64"},{"name":"name","type":"STRING"},{"name":"age","type":"INT64"},{"name":"city","type":"STRING"},{"name":"score","type":"FLOAT64"},{"name":"active","type":"BOOLEAN"},{"name":"joined","type":"DATE"}]}

# every forced encoding and small row groups
save tx out/tx_plain.pqcf encoding=plain row_group_size=300
save tx out/tx_dict.pqcf encoding=dict row_group_size=1000
save tx out/tx_rle.pqcf encoding=rle row_group_size=777
save tx out/tx_auto.pqcf encoding=auto
open tx_plain out/tx_plain.pqcf
open tx_dict out/tx_dict.pqcf
open tx_rle out/tx_rle.pqcf
open tx_auto out/tx_auto.pqcf mmap=true

query ordered oracle
SELECT currency, COUNT(*) AS n, SUM(amount) AS s, MIN(ts) AS first_ts, MAX(fee) AS max_fee, COUNT(fee) AS fees FROM tx_plain GROUP BY currency ORDER BY currency
----
currency STRING | n INT64 | s DECIMAL(18,2) | first_ts TIMESTAMP | max_fee DECIMAL(10,2) | fees INT64
["EUR", 855, "4946296.70", "2023-01-01 07:07:28.922000", "9815.28", 609]
["GBP", 291, "2725881.11", "2023-01-02 07:15:07.791000", "9150.61", 220]
["JPY", 176, "1547375.93", "2023-01-01 18:16:13.668000", "8130.06", 121]
["SEK", 206, "2149257.77", "2023-01-04 17:37:17.839000", "8777.85", 145]
["USD", 472, "3112974.69", "2023-01-02 10:23:22.591000", "9929.93", 320]

query ordered oracle
SELECT currency, COUNT(*) AS n, SUM(amount) AS s, MIN(ts) AS first_ts, MAX(fee) AS max_fee, COUNT(fee) AS fees FROM tx_dict GROUP BY currency ORDER BY currency
----
currency STRING | n INT64 | s DECIMAL(18,2) | first_ts TIMESTAMP | max_fee DECIMAL(10,2) | fees INT64
["EUR", 855, "4946296.70", "2023-01-01 07:07:28.922000", "9815.28", 609]
