# top-N with parallel scans
query ordered oracle options={"mode": "vectorized", "threads": 4}
SELECT tx_id, amount FROM tx WHERE status = 'approved' ORDER BY amount DESC, tx_id LIMIT 5
----
tx_id INT64 | amount DECIMAL(12,2)
[1360, "854943.05"]
[1508, "835846.29"]
[1171, "812969.73"]
[1462, "794411.60"]
[1764, "588106.94"]

error UNSUPPORTED options={"mode": "quantum"}
SELECT 1

error UNSUPPORTED options={"join": "teleport"}
SELECT 1

# errors are raised identically in every mode
error NUMERIC_OVERFLOW options={"mode": "vectorized", "threads": 4}
SELECT SUM(tx_id * 4611686018427387) FROM tx

error DIVISION_BY_ZERO options={"mode": "vectorized", "threads": 4}
SELECT tx_id / (bucket - bucket) FROM tx
