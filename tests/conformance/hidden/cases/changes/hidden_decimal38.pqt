# CR-2 hidden acceptance cases — spec/changes/decimal38.md
# Expected values computed with Python's decimal module (100-digit context), reviewed by hand.
@phase 3
@requires phase3 change.decimal38 sql.groupby sql.subquery storage.pqcf ingest.csv ingest.jsonl

data h jsonl schema=k:STRING;x:DECIMAL(31,9);y:DECIMAL(22,2);z:DECIMAL(19,0)
{"k": "p", "x": -98765432109876543210.987654321, "y": 11111111111111111111.11, "z": 9999999999999999999}
{"k": "p", "x": "0.000000001", "y": "22222222222222222222.22", "z": -9999999999999999999}
{"k": "q", "x": null, "y": 0.5, "z": 0}
.

query ordered
SELECT k, ABS(MIN(x)) AS ax, SUM(y) AS sy, MAX(z) * MAX(z) AS zz FROM h GROUP BY k ORDER BY k
----
k STRING | ax DECIMAL(31,9) | sy DECIMAL(38,2) | zz DECIMAL(38,0)
["p", "98765432109876543210.987654321", "33333333333333333333.33", "99999999999999999980000000000000000001"]
["q", null, "0.50", "0"]

query
SELECT ROUND(CAST('12345678901234567895.5' AS DECIMAL(21,1)), -1) AS r, CAST('22222222222222222222.22' AS DECIMAL(22,2)) - CAST('11111111111111111111.11' AS DECIMAL(22,2)) AS d, CAST('11111111111111111111.11' AS DECIMAL(22,2)) * 0.5 AS m
----
r DECIMAL(38,0) | d DECIMAL(38,2) | m DECIMAL(38,3)
["12345678901234567900", "11111111111111111111.11", "5555555555555555555.555"]

query ordered
SELECT k FROM h WHERE y IN (0.5, 11111111111111111111.11) ORDER BY k
----
k STRING
["p"]
["q"]

query
SELECT (SELECT MAX(y) FROM h) > 9223372036854775807 AS a, NULLIF(CAST(5 AS DECIMAL(20,0)), 5) AS b, CASE WHEN FALSE THEN 1 ELSE CAST('0.000000001' AS DECIMAL(25,9)) END AS c
----
a BOOLEAN | b DECIMAL(20,0) | c DECIMAL(38,9)
[true, null, "0.000000001"]

query
SELECT CAST(CAST('0.30000000000000000000000000000000000001' AS DECIMAL(38,38)) AS FLOAT64) AS f, CAST(CAST('-9223372036854775808.9' AS DECIMAL(25,1)) AS INT64) AS i
----
f FLOAT64 | i INT64
[0.3, -9223372036854775808]

error NUMERIC_OVERFLOW
SELECT SUM(z) + CAST('99999999999999999999999999999999999999' AS DECIMAL(38,0)) + 1 FROM h

save h out/h.pqcf encoding=plain
pqcf out/h.pqcf 2
open h2 out/h.pqcf

query ordered
SELECT k, x, y, z FROM h2 ORDER BY z
----
k STRING | x DECIMAL(31,9) | y DECIMAL(22,2) | z DECIMAL(19,0)
["p", "0.000000001", "22222222222222222222.22", "-9999999999999999999"]
["q", null, "0.50", "0"]
["p", "-98765432109876543210.987654321", "11111111111111111111.11", "9999999999999999999"]

data n csv schema=v:DECIMAL(18,4)
v
12345678901234.5678
.

save n out/n.pqcf
pqcf out/n.pqcf 1
