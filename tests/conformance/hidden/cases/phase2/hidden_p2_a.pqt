# HIDDEN acceptance — Phase 2 (oracle-derived where possible)
@phase 2
@requires phase2 sql.groupby sql.join sql.functions sql.subquery sql.cte ingest.csv

load o fixtures/gen/orders.csv schemafile=fixtures/gen/orders.schema.json
load i fixtures/gen/order_items.csv schemafile=fixtures/gen/order_items.schema.json
load p fixtures/gen/products.csv schemafile=fixtures/gen/products.schema.json
load c fixtures/gen/customers.csv schemafile=fixtures/gen/customers.schema.json
load s fixtures/gen/sensor_readings.csv schemafile=fixtures/gen/sensor_readings.schema.json

query ordered oracle
SELECT p.brand, COUNT(DISTINCT i.order_id) AS orders, SUM(i.quantity) AS units FROM i JOIN p ON p.product_id = i.product_id GROUP BY p.brand HAVING SUM(i.quantity) > 100 ORDER BY units DESC, p.brand
----
brand STRING | orders INT64 | units INT64
["Globex", 359, 2642]
["Stark", 331, 2531]
["Acme", 203, 1312]
["Umbrella", 164, 951]
["Hooli", 146, 904]
["Initech", 95, 593]
["Tyrell", 75, 430]
["Cyberdyne", 74, 427]
["Wonka", 70, 422]
["Soylent", 54, 343]
["Vandelay", 31, 139]

query ordered oracle
SELECT o.status, COUNT(*) AS n, MIN(o.order_date) AS first_day, MAX(o.order_date) AS last_day FROM o GROUP BY o.status ORDER BY n DESC, o.status
----
status STRING | n INT64 | first_day DATE | last_day DATE
["shipped", 88, "2023-02-05", "2024-12-15"]
["cancelled", 87, "2023-01-02", "2024-11-26"]
["delivered", 87, "2023-01-05", "2024-12-26"]
["returned", 86, "2023-01-02", "2024-12-25"]
["placed", 83, "2023-01-09", "2024-12-19"]
["paid", 69, "2023-02-09", "2024-12-22"]

query ordered oracle
SELECT c.country, COUNT(o.order_id) AS orders FROM c LEFT JOIN o ON o.customer_id = c.customer_id GROUP BY c.country HAVING COUNT(o.order_id) = 0 OR COUNT(o.order_id) > 40 ORDER BY c.country
----
country STRING | orders INT64
["CL", 0]
["GB", 112]
["SG", 0]
["US", 146]

query ordered oracle
WITH per_order AS (SELECT order_id, SUM(quantity * unit_price) AS gross, COUNT(discount) AS discounted FROM i GROUP BY order_id)
SELECT o.status, COUNT(*) AS n, SUM(po.gross) AS gross, SUM(po.discounted) AS d FROM per_order po JOIN o ON o.order_id = po.order_id GROUP BY o.status ORDER BY o.status
----
status STRING | n INT64 | gross DECIMAL(18,2) | d INT64
["cancelled", 87, "186167.62", 57]
["delivered", 87, "193844.88", 69]
["paid", 69, "155339.29", 61]
["placed", 83, "178340.97", 76]
["returned", 86, "186201.60", 77]
["shipped", 88, "205553.37", 66]

query ordered oracle
SELECT name FROM p WHERE price > (SELECT AVG(price) FROM p) AND category IN (SELECT category FROM p WHERE brand = 'Acme') ORDER BY name
----
name STRING
["bravo-echo-41"]
["bravo-november-20"]
["delta-quebec-47"]
["echo-golf-17"]
["echo-hotel-18"]
["hotel-golf-7"]
["juliet-foxtrot-22"]
["juliet-golf-1"]
["juliet-papa-32"]
["oscar-delta-48"]
["oscar-echo-24"]
["oscar-kilo-4"]
["tango-charlie-28"]

query ordered oracle
SELECT segment, CASE WHEN is_active THEN 'active' ELSE 'inactive' END AS state, COUNT(*) AS n, AVG(birth_year) AS avg_by FROM c GROUP BY segment, state ORDER BY segment, state
----
segment STRING | state STRING | n INT64 | avg_by FLOAT64
["consumer", "active", 90, 1971.888888888889]
["consumer", "inactive", 13, 1971.4615384615386]
["enterprise", "active", 24, 1969.7916666666667]
["enterprise", "inactive", 6, 1969.5]
["public_sector", "active", 17, 1971.235294117647]
["public_sector", "inactive", 8, 1980.375]
["small_business", "active", 34, 1973.2058823529412]
["small_business", "inactive", 8, 1973.125]

query ordered oracle
SELECT UPPER(SUBSTR(name, 1, 3)) AS pfx, COUNT(*) AS n FROM c WHERE email LIKE '%a%a%' GROUP BY UPPER(SUBSTR(name, 1, 3)) HAVING COUNT(*) >= 3 ORDER BY n DESC, pfx
----
pfx STRING | n INT64
["ELI", 10]
["LIL", 10]
["ISL", 9]
["SAG", 9]
["AIN", 8]
["JAS", 8]
["LIA", 8]
["LUC", 8]
["MIA", 8]
["OLI", 8]
["OSC", 8]
["AVA", 7]
["KAI", 7]
["MAX", 7]
["ELL", 6]
["EMM", 6]
["VEN", 6]
["NOA", 5]
["NOR", 5]
["SOF", 5]
["AAD", 4]
["ART", 4]
["LEO", 4]
["VEE", 4]

query ordered oracle
SELECT sensor_id, COUNT(*) AS n, MAX(temperature) - MIN(temperature) AS spread FROM s WHERE sensor_id IN (1, 2, 3) GROUP BY sensor_id ORDER BY sensor_id
----
sensor_id INT64 | n INT64 | spread FLOAT64
[1, 200, 14.879999999999999]
[2, 200, 14.920000000000002]
[3, 200, 14.91]

query ordered oracle
SELECT DISTINCT p.category FROM p JOIN i ON i.product_id = p.product_id WHERE i.quantity = 10 ORDER BY p.category
----
category STRING
["automotive"]
["beauty"]
["books"]
["clothing"]
["education"]
["electronics"]
["entertainment"]
["fuel"]
["groceries"]
["health"]
["home"]
["insurance"]
["pets"]
["restaurants"]
["services"]
["travel"]
["utilities"]

query oracle
SELECT COUNT(*) AS n FROM o WHERE NOT EXISTS (SELECT 1 FROM c WHERE c.customer_id = 999999) AND order_id NOT IN (SELECT order_id FROM i WHERE line_no = 1 AND quantity > 5)
----
n INT64
[266]

query ordered oracle
SELECT a.order_id, b.order_id AS same_day FROM o a JOIN o b ON a.order_date = b.order_date AND a.order_id < b.order_id WHERE a.customer_id = 1 ORDER BY a.order_id, same_day LIMIT 10
----
order_id INT64 | same_day INT64
[11, 99]
[60, 88]
[107, 382]
[107, 458]
[128, 156]
[128, 221]
[137, 379]
[141, 230]
[144, 210]
[144, 371]

query ordered oracle
SELECT x, COUNT(*) AS n FROM (SELECT LENGTH(name) % 3 AS x FROM p) t GROUP BY x ORDER BY x
----
x INT64 | n INT64
[0, 17]
[1, 19]
[2, 14]

error SEMANTIC_ERROR
SELECT o.status, i.quantity FROM o JOIN i ON i.order_id = o.order_id GROUP BY o.status

error SUBQUERY_CARDINALITY
SELECT (SELECT product_id FROM p WHERE brand = 'Acme') AS x

error TYPE_ERROR
SELECT COUNT(*) FROM o JOIN c ON o.order_date = c.name

error SEMANTIC_ERROR
WITH x AS (SELECT 1 AS a) SELECT b FROM x
